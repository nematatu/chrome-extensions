{
  "manifest_version": 3,
  "name": "better-ig",
  "version": "2.0.0",
  "description": "Instagramの画像・動画保存、高画質表示、Live横向き表示をまとめて操作します。",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "storage",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "better-ig",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "core.js",
        "bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "ui-kit.js",
        "core.js",
        "instagram-api.js",
        "quality-core.js",
        "quality-content.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "ui-tokens.css",
        "quality.css"
      ]
    }
  ]
}
