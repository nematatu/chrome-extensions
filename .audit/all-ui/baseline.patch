+main { max-width: 880px; max-height: 600px; overflow-y: auto; margin: 0 auto; }
+.app-header { display: flex; align-items: center; justify-content: space-between; padding: 20px 24px 16px; }
+.icon-button { display: inline-flex; justify-content: center; align-items: center; width: 32px; height: 32px; padding: 0; border: 0; border-radius: 6px; background: transparent; color: var(--gray-11); flex-shrink: 0; }
+.icon-button:hover:enabled { background: var(--gray-3); color: var(--gray-12); }
+.tabs { display: flex; gap: 24px; border-bottom: .5px solid var(--gray-6); padding: 0 24px; }
+.tab { position: relative; padding: 8px 0 12px; background: transparent; color: var(--gray-11); border: 0; font-weight: 500; }
+.tab[data-state='active'] { color: var(--gray-12); }
+.tab[data-state='active']::after { position: absolute; content: ''; height: 2px; inset: auto 0 0; background: var(--indigo-9); }
+.search-bar { display: flex; align-items: center; gap: 8px; margin: 20px 24px 12px; padding: 0 10px; min-height: 38px; border: .5px solid var(--gray-7); background: var(--gray-2); border-radius: 8px; color: var(--gray-11); }
+.search-bar:focus-within { outline: 2px solid var(--indigo-8); outline-offset: 2px; }
+.search-bar input { min-width: 0; width: 100%; padding: 8px 0; color: var(--gray-12); background: transparent; border: 0; outline: none; }
+.search-bar input::placeholder { color: var(--gray-10); }
+.search-bar input::-webkit-search-cancel-button { display: none; }
+.clear-search { width: 24px; height: 24px; border-radius: 4px; }
+.clear-search svg { width: 16px; height: 16px; }
+.list-summary { display: flex; justify-content: space-between; padding: 0 24px 10px; color: var(--gray-11); font-size: 12px; }
+.module-list { max-height: 300px; overflow-y: auto; scrollbar-gutter: stable; padding: 0 16px 8px 24px; overscroll-behavior: contain; }
+.module-group + .module-group { padding-top: 16px; }
+.module-group h2 { font-size: 12px; color: var(--gray-11); font-weight: 500; padding: 6px 0; }
+.module { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 46px; border-bottom: .5px solid var(--gray-4); }
+.module:last-child { border-bottom: 0; }
+.module-name { min-width: 0; cursor: pointer; }
+.module-controls { display: flex; align-items: center; justify-content: flex-end; gap: 10px; flex-shrink: 0; }
+.module-badge { min-width: 20px; padding: 1px 5px; text-align: center; font-size: 12px; color: var(--indigo-11); background: var(--indigo-3); border-radius: 4px; }
+.switch { display: flex; align-items: center; width: 32px; height: 20px; padding: 2px; border: .5px solid var(--gray-7); border-radius: 10px; background: var(--gray-6); }
+.switch[data-state='checked'] { background: var(--indigo-9); border-color: var(--indigo-9); }
+.switch-thumb { display: block; width: 14px; height: 14px; border-radius: 8px; background: var(--gray-1); }
+.switch-thumb[data-state='checked'] { transform: translateX(12px); }
+.dark .switch-thumb { background: var(--gray-12); }
+.tools-footer { padding: 16px 24px 20px; border-top: .5px solid var(--gray-6); }
+.button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 38px; padding: 8px 12px; border: .5px solid var(--gray-7); border-radius: 8px; background: var(--gray-2); color: var(--gray-12); font-weight: 500; text-decoration: none; }
+.button:hover:enabled, .file-button:not(.disabled):hover { background: var(--gray-3); }
+.primary { border-color: var(--indigo-7); background: var(--indigo-3); color: var(--indigo-11); }
+.primary:hover:enabled { background: var(--indigo-4); }
+#save { width: 100%; }
+.empty-state { padding: 32px 0; color: var(--gray-11); text-align: center; }
+.backup { padding: 24px; min-height: 350px; }
+#history-count { margin-top: 8px; color: var(--gray-11); }
+#history-count strong { font-weight: 500; color: var(--gray-12); }
+.backup-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 24px; }
+.file-button { position: relative; overflow: hidden; cursor: pointer; }
+.file-button input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
+.backup-notes { display: grid; gap: 12px; margin-top: 24px; color: var(--gray-11); font-size: 12px; }
+.status { display: flex; align-items: flex-start; gap: 8px; padding: 12px 24px; border-top: .5px solid var(--gray-6); color: var(--green-11); font-size: 12px; overflow-wrap: anywhere; }
+.status svg { width: 16px; height: 16px; margin-top: 1px; }
+.status.error, #diagnostics { color: var(--red-11); }
+#diagnostics { padding: 12px 24px; background: var(--red-2); border-top: .5px solid var(--red-6); font-size: 12px; overflow-wrap: anywhere; }
+.panel-header { display: flex; align-items: center; gap: 8px; padding: 0 16px 12px; border-bottom: .5px solid var(--gray-6); }
+#module-frame { display: block; width: 100%; height: 440px; border: 0; background: var(--gray-1); }
+@media (min-width: 700px) {
+  body { width: auto; min-width: 700px; }
+  main { max-height: none; overflow: visible; padding-top: 24px; }
+  .app-header { padding-top: 24px; }
+  .module-list { columns: 2; column-gap: 40px; max-height: none; padding-right: 24px; }
+  .module-group { break-inside: avoid; padding-bottom: 20px; }
+  .module-group + .module-group { padding-top: 0; }
+  .empty-state { column-span: all; }
+  .module { min-height: 52px; }
+  .backup { min-height: 480px; }
+  #module-frame { height: 640px; }
+}
