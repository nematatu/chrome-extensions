{
  "manifest_version": 3,
  "name": "Instagram High Quality Images",
  "version": "2.3.0",
  "description": "Instagramの投稿画像を最大解像度で表示し、縦長のInstagram Liveを横向き表示します。",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "Instagram High Quality Images",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "quality-core.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "116"
}
