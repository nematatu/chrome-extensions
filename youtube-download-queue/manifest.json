{
  "manifest_version": 3,
  "name": "YouTube ダウンロードキュー",
  "version": "1.0.0",
  "description": "YouTube の動画を Auto-YTDLP の links.txt へワンクリックで追加し、登録済み・ダウンロード済みを表示します。",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YouTube ダウンロードキュー",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "ui-kit.js",
        "core.js",
        "content.js"
      ],
      "css": [
        "ui-tokens.css",
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
