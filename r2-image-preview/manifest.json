{
  "manifest_version": 3,
  "name": "R2 Image Preview",
  "version": "0.1.1",
  "description": "Cloudflare R2一覧に画像プレビューを表示します",
  "permissions": ["storage"],
  "host_permissions": ["https://dash.cloudflare.com/*/r2/*"],
  "content_scripts": [
    {
      "matches": ["https://dash.cloudflare.com/*/r2/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
